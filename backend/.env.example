# Postgres connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/octocode?schema=public"

# HTTP
PORT=3333
NODE_ENV=development

# Frontend origin allowed by CORS (must match the SPA URL exactly, no trailing slash).
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# GitHub OAuth App credentials.
# Create at: GitHub → Settings → Developer settings → OAuth Apps.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL="http://localhost:3333/auth/github/callback"

# Google Calendar OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Enable the Google Calendar API and add the callback URL below as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:3333/calendar/google/callback"
# Time zone used when creating Google events (per-user time zones are not modeled yet).
GOOGLE_CALENDAR_TIME_ZONE="UTC"
# How often connected users' calendars are synchronised in the background.
GOOGLE_CALENDAR_SYNC_INTERVAL_MS=900000

# Session cookie.
SESSION_COOKIE_NAME="octocode_session"
SESSION_TTL_DAYS=30
# Set to "true" only when serving over HTTPS.
COOKIE_SECURE=false
# How often expired/revoked sessions are purged from the database.
SESSION_CLEANUP_INTERVAL_MS=21600000

# Rate limiting (requests per window, per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# base64-encoded 32-byte key used to encrypt OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Dev-only: enable POST /auth/dev-token to sign in with a GitHub personal access
# token instead of the OAuth flow. NEVER enable this in production.
ALLOW_DEV_TOKEN_LOGIN=false
